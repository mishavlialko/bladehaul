# Public site origin. Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://bladehaul.com

# Resend (transactional email). Leave empty in dev — the quote API then
# logs to the console instead of sending email.
RESEND_API_KEY=

# BeRocker CRM webhook. Leave empty until the CRM is activated (post-MC#).
BEROCKER_WEBHOOK_URL=

# Where the admin notification for each quote request is sent.
ADMIN_EMAIL=misha@bladehaul.com
