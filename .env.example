# Public site origin. Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://bladehaul.com

# False until the documented launch gates, inbox test and WAF rules pass.
# The public API returns 503 while disabled or incompletely configured.
QUOTE_INTAKE_ENABLED=false

# Use a PRIVATE Blob store, connected through Vercel OIDC. Let the SDK read and
# refresh VERCEL_OIDC_TOKEN automatically; never copy that managed token here.
# Connect DIFFERENT stores to production and preview/development environments.
BLOB_STORE_ID=
# Must match VERCEL_ENV exactly: production, preview, or development locally.
QUOTE_STORAGE_NAMESPACE=development
# Optional outside Vercel only, for an isolated private development store.
# Never use production store credentials for local or preview testing.
BLOB_READ_WRITE_TOKEN=

# Server-only Resend full-access key (sending plus delivery-status retrieval).
# Verify the sender domain before enabling intake. No customer emails are sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BladeHaul <quotes@bladehaul.com>"
ADMIN_EMAIL=info@bladehaul.com

# Separate EMAIL ATTEMPT allocation; every POST attempt, including retries,
# reserves capacity in private Blob before contacting Resend. These are safe
# starting allocations against the currently verified account, not plan quotas.
# Missing/invalid values pause mail; verified requests can still be saved.
# Rolling windows: hour, 24 hours, and 32 days. New admissions have a separate
# owner-approved 100/24h ceiling, independent of mail and without quality scoring.
QUOTE_EMAIL_HOURLY_LIMIT=25
QUOTE_EMAIL_DAILY_LIMIT=80
QUOTE_EMAIL_MONTHLY_LIMIT=2000

# Generate at least 32 random characters privately. Vercel cron passes this in
# the Authorization header. No secret/query-parameter links or PII in logs.
# Also protects ?mode=health and ?mode=record&quoteId=<UUID> manual recovery.
CRON_SECRET=

# Vercel Pro cron: every 5 minutes; private backups expire after 30 days.
# Transfer real shipment/dispute records into the business archive before then.
# Configure Vercel WAF limits for POST /api/quote before activation; there is no
# unreliable per-instance in-memory limiter and no BeRocker/payment integration.
